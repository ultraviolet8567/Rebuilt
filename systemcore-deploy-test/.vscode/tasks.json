{
    // Run with Terminal > Run Task, or Cmd+Shift+B for the default (deploy, then probe).
    // These call the same Gradle tasks that the WPILib extension's "Deploy Robot Code" calls.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Systemcore: deploy",
            "type": "shell",
            "command": "./gradlew deploy",
            "problemMatcher": ["$gradle"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Systemcore: probe (read back nonce and counter)",
            "type": "shell",
            "command": "sleep 22 && ./gradlew ntProbe",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Systemcore: deploy, then probe",
            "dependsOrder": "sequence",
            "dependsOn": ["Systemcore: deploy", "Systemcore: probe (read back nonce and counter)"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Systemcore: robot service log",
            "type": "shell",
            "command": "curl -s \"http://$(dscacheutil -q host -a name robot.local | awk '/ip_address/{print $2; exit}'):4802/api/logs/service/robot?lines=60\" | python3 -c 'import sys,json; d=json.load(sys.stdin)[\"logs\"]; print(\"\\n\".join(d) if isinstance(d,list) else d)' | grep -v can_s",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        }
    ]
}
